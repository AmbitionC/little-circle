# 渲染输出、模型、字体和缓存
out/
**/.cache/
**/.work/
models/
tools/storybook-video/fonts/
__pycache__/
*.pyc
.venv/
# 演示素材由 make_demo_assets.py 生成
tools/storybook-video/example/*.png
tools/storybook-video/example/*.mp4
.DS_Store

# ElevenLabs 生成的音效和音乐只留在本机（仓库公开）
assets/sfx/
assets/bgm/

# 剧集素材（图、可灵片段）只留在本机
episodes/**/*.png
episodes/**/*.jpg
episodes/**/*.mp4

# Codex 出图的日志和本机记录
episodes/**/.codex_images.log
episodes/**/images.json

# 用户给的画风样张，只留在本机
series/style/

series/style_old/
